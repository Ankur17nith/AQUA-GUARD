# AQUA//GUARD Environment Configuration

# Database: SQLite for zero-setup local dev / PostgreSQL+PostGIS in production & docker
DATABASE_URL=sqlite+aiosqlite:///./aquaguard.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://aquaguard:aquaguard_secret@localhost:5432/aquaguard

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Primary Data Source: Conduit@Empathy (3D-PAWS UCAR Network)
CONDUIT_API_URL=https://3d-fewsnet.icdp.ucar.edu/api/v1/data/61.geojson
CONDUIT_API_KEY=71VcHDXG-zo1ezcgxAts
CONDUIT_API_EMAIL=3dpaws@meteo.go.ke
CONDUIT_STATION_ID=61

# Secondary Context (Weather & Satellite)
WEATHER_API_URL=https://api.open-meteo.com/v1
OPENAI_API_KEY=

# Application Mode: DEMO (deterministic, reliable offline demo) or LIVE (queries live Conduit network)
AQUAGUARD_MODE=DEMO

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
